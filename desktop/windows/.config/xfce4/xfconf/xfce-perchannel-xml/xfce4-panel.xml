<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="panels" type="array">
    <value type="int" value="1"/>
    <property name="dark-mode" type="bool" value="false"/>
    <!-- Windows taskbar. Left: Start, search, pinned apps, running tasks.
         Right: notifications, tray, time over date, show-desktop corner. -->
    <property name="panel-1" type="empty">
      <property name="position" type="string" value="p=8;x=0;y=0"/>
      <property name="length" type="uint" value="100"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="size" type="uint" value="40"/>
      <property name="icon-size" type="uint" value="24"/>
      <property name="background-style" type="uint" value="1"/>
      <property name="background-rgba" type="array">
        <value type="double" value="0.953"/>
        <value type="double" value="0.953"/>
        <value type="double" value="0.953"/>
        <value type="double" value="0.94"/>
      </property>
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/>
        <value type="int" value="2"/>
        <value type="int" value="3"/>
        <value type="int" value="4"/>
        <value type="int" value="5"/>
        <value type="int" value="6"/>
        <value type="int" value="7"/>
        <value type="int" value="8"/>
        <value type="int" value="9"/>
        <value type="int" value="13"/>
        <value type="int" value="10"/>
        <value type="int" value="11"/>
        <value type="int" value="12"/>
      </property>
    </property>
  </property>
  <property name="plugins" type="empty">
    <!-- Start -->
    <property name="plugin-1" type="string" value="whiskermenu"/>
    <!-- Search -->
    <property name="plugin-2" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="search.desktop"/>
      </property>
      <property name="show-label" type="bool" value="false"/>
    </property>
    <!-- Pinned: File Explorer, Terminal, Browser -->
    <property name="plugin-3" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="files.desktop"/>
      </property>
      <property name="show-label" type="bool" value="false"/>
    </property>
    <property name="plugin-4" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="terminal.desktop"/>
      </property>
      <property name="show-label" type="bool" value="false"/>
    </property>
    <property name="plugin-5" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="browser.desktop"/>
      </property>
      <property name="show-label" type="bool" value="false"/>
    </property>
    <property name="plugin-6" type="string" value="separator">
      <property name="expand" type="bool" value="false"/>
      <property name="style" type="uint" value="1"/>
    </property>
    <!-- Running windows, grouped, with titles -->
    <property name="plugin-7" type="string" value="tasklist">
      <property name="show-labels" type="bool" value="true"/>
      <property name="grouping" type="bool" value="true"/>
      <property name="flat-buttons" type="bool" value="true"/>
      <property name="show-handle" type="bool" value="false"/>
      <property name="include-all-workspaces" type="bool" value="true"/>
      <property name="middle-click" type="uint" value="1"/>
    </property>
    <property name="plugin-8" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="uint" value="0"/>
    </property>
    <!-- Notification bell with Do Not Disturb -->
    <property name="plugin-9" type="string" value="notification-plugin"/>
    <!-- Volume (remote audio via the CRD host's PipeWire) -->
    <property name="plugin-13" type="string" value="pulseaudio">
      <property name="enable-keyboard-shortcuts" type="bool" value="true"/>
      <property name="show-notifications" type="bool" value="true"/>
      <property name="mixer-command" type="string" value="pavucontrol"/>
    </property>
    <property name="plugin-10" type="string" value="systray">
      <property name="square-icons" type="bool" value="true"/>
      <property name="icon-size" type="int" value="20"/>
    </property>
    <!-- Time above date, like the Windows tray clock -->
    <property name="plugin-11" type="string" value="clock">
      <property name="mode" type="uint" value="2"/>
      <property name="digital-layout" type="uint" value="1"/>
      <property name="digital-time-format" type="string" value="%H:%M"/>
      <property name="digital-date-format" type="string" value="%d/%m/%Y"/>
      <property name="digital-time-font" type="string" value="Inter 10"/>
      <property name="digital-date-font" type="string" value="Inter 9"/>
    </property>
    <!-- Show-desktop sliver in the corner -->
    <property name="plugin-12" type="string" value="showdesktop"/>
  </property>
</channel>
