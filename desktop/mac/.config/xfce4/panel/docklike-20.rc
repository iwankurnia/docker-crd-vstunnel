[user]
# Pinned apps are filled in at image build time from what is installed.
pinned=@PINNED@
iconSize=46
forceIconSize=true
showPreviews=true
showWindowCount=false
noWindowsListIfSingle=true
onlyDisplayVisible=false
onlyDisplayScreen=false
indicatorStyle=1
inactiveIndicatorStyle=5
indicatorColorFromTheme=false
indicatorColor=rgb(60,60,67)
inactiveColor=rgb(142,142,147)
indicatorOrientation=0
keyComboActive=true
keyAloneActive=false
middleButtonBehavior=0
