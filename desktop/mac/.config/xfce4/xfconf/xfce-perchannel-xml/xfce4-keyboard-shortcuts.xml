<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-keyboard-shortcuts" version="1.0">
  <property name="commands" type="empty">
    <property name="custom" type="empty">
      <!-- Cmd+Space from a Mac arrives as Super+Space: Spotlight-style launcher -->
      <property name="&lt;Super&gt;space" type="string" value="xfce4-appfinder --collapsed"/>
      <property name="&lt;Super&gt;Return" type="string" value="xfce4-terminal"/>
      <property name="&lt;Super&gt;e" type="string" value="thunar"/>
    </property>
  </property>
  <property name="xfwm4" type="empty">
    <property name="custom" type="empty">
      <property name="&lt;Super&gt;q" type="string" value="close_window_key"/>
      <property name="&lt;Super&gt;m" type="string" value="hide_window_key"/>
      <property name="&lt;Super&gt;Tab" type="string" value="cycle_windows_key"/>
    </property>
  </property>
</channel>
