# Copy to .env and adjust.

# --- Identity ----------------------------------------------------------------
# Used as the container hostname, the VS Code tunnel name and the Chrome Remote
# Desktop device name. Lowercase letters, digits and hyphens, max 20 characters.
COMPUTER_NAME=debian-remote

# Linux account inside the container. Changing it later needs
# `docker compose build` and a fresh home volume.
USERNAME=remote

# Password for that account: sudo (and anything else that asks) uses it.
# Applied at every start. Leave empty for passwordless sudo (not recommended).
USER_PASSWORD=change-me

# --- Options -----------------------------------------------------------------
# Desktop layout baked into the image at build time: "mac" (top menu bar,
# window buttons on the left, dock at the bottom) or "windows" (one taskbar
# at the bottom with Start menu, task buttons, tray and clock). Both use the
# light Arc theme with platform-matched icons (WhiteSur / Fluent). Change it,
# then `docker compose build`.
DESKTOP_LAYOUT=mac

# --- Developer toolchain (build time) ---------------------------------------
# Node major installed by nvm and set as default (`nvm install` adds more later).
NODE_DEFAULT=22
# .NET SDK channels installed side by side, latest patch of each at build time.
# .NET 8 leaves support on 2026-11-10; .NET 10 is the long-term choice.
DOTNET_CHANNELS="8.0 10.0"

# Set to false to run Chrome Remote Desktop only.
VSCODE_TUNNEL_ENABLED=true

TZ=Asia/Jakarta

# Display sizes offered to Chrome Remote Desktop clients.
CRD_DESKTOP_SIZES=1920x1080,2560x1440

# Extra Debian packages baked into the image, e.g. a browser.
# (chromium needs --no-sandbox inside a container; firefox-esr works as-is)
EXTRA_PACKAGES=firefox-esr

# --- Chrome Remote Desktop one-shot registration -----------------------------
# Open https://remotedesktop.google.com/headless -> Begin -> Next -> Authorise,
# pick "Debian Linux" and copy the --code="..." value from the command shown.
# The code is single-use and expires within minutes, so fill these in and run
# `docker compose up -d` straight away. Once registered the values are ignored;
# you can blank them out afterwards.
CRD_CODE=
# PIN of at least six digits that the Chrome Remote Desktop client will ask for.
# Stored in plain text here: keep .env out of git (it is in .gitignore).
CRD_PIN=
# Only change if the headless page shows a different --redirect-url.
CRD_REDIRECT_URL=https://remotedesktop.google.com/_/oauthredirect
